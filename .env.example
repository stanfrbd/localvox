# Generate a secret: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LOCALVOX_TOKEN=replace-with-a-long-random-token
LOCALVOX_PORT=8000
LOCALVOX_BACKEND=parakeet
LOCALVOX_MODEL_DIR=.cache/models
LOCALVOX_TEMP_DIR=.cache/tmp
LOCALVOX_CPU_THREADS=2
LOCALVOX_MAX_FILES=8
LOCALVOX_MAX_FILE_MB=25
LOCALVOX_MAX_SECONDS=300
LOCALVOX_MAX_PENDING=2
LOCALVOX_QUEUE_TIMEOUT=30
LOCALVOX_UPLOAD_TIMEOUT=120
LOCALVOX_TASK_TIMEOUT=180
# Set true with HTTPS (required for Android PWA installation on a network address).
LOCALVOX_SECURE_COOKIE=false
